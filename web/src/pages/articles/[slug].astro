---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getArticleTags } from '../../lib/tags';
import { sceneForArticle } from '../../lib/scenes';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const typeLabel: Record<string, string> = {
  'single-skill': '单 Skill',
  'plugin-skill': 'Plugin Skill',
  'plugin-overview': 'Plugin 总览',
  'plugin-doc': '工程文档',
};

const isSourceAvailable = article.data.license.toLowerCase().includes('source-available');
const tags = getArticleTags(article);
const scene = sceneForArticle(article.id);

const articleUrl = new URL(`/articles/${article.id}/`, Astro.site).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.data.title,
  description: article.data.description,
  inLanguage: 'zh-CN',
  url: articleUrl,
  author: {
    '@type': 'Person',
    name: article.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Claude Skills 中文市集',
    url: 'https://claudeskill.me',
  },
  datePublished: article.data.last_synced.toISOString().slice(0, 10),
  dateModified: article.data.last_synced.toISOString().slice(0, 10),
  keywords: (article.data.keywords ?? []).join(', '),
  isBasedOn: article.data.source,
  license: article.data.license,
  mainEntityOfPage: articleUrl,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://claudeskill.me/' },
    { '@type': 'ListItem', position: 2, name: '全部 Skills', item: 'https://claudeskill.me/skills/' },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: articleUrl },
  ],
};
---
<Base
  title={article.data.title}
  description={article.data.description}
  keywords={article.data.keywords ?? []}
  ogType="article"
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <article class="container prose" data-pagefind-body>
    <nav class="breadcrumb" data-pagefind-ignore>
      <a href="/">首页</a>
      <span class="breadcrumb-sep">›</span>
      {scene ? (
        <>
          <a href={`/#scene-${scene.slug}`}>{scene.emoji} {scene.label}</a>
          <span class="breadcrumb-sep">›</span>
        </>
      ) : (
        <>
          <a href="/skills/">全部 Skills</a>
          <span class="breadcrumb-sep">›</span>
        </>
      )}
      <span>{article.data.title}</span>
    </nav>

    <h1>{article.data.title}</h1>

    <div class="article-meta">
      <span class="badge" data-pagefind-filter={`type:${typeLabel[article.data.source_type] ?? article.data.source_type}`}>
        {typeLabel[article.data.source_type] ?? article.data.source_type}
      </span>
      {article.data.plugin && (
        <a class="badge badge-author" href={`/plugins/${article.data.plugin}/`} data-pagefind-filter={`plugin:${article.data.plugin}`}>
          plugin: {article.data.plugin}
        </a>
      )}
      <span class="badge badge-author" data-pagefind-filter={`author:${article.data.author}`}>{article.data.author}</span>
      <span class="badge badge-author">{article.data.license}</span>
      <span>原文：<a href={article.data.source} target="_blank" rel="noopener">GitHub</a></span>
      <span>最后同步：{article.data.last_synced.toISOString().slice(0, 10)}</span>
    </div>

    {article.data.ai_generated && (
      <div class="ai-disclaimer">
        本文由 AI ({article.data.model ?? 'Claude'}) 辅助生成，基于
        <a href={article.data.source} target="_blank" rel="noopener">原始 SKILL.md</a> 整理而成。
        如有出入以原文为准。
        {isSourceAvailable && (
          <>
            <br />
            <strong>注意</strong>：本 Skill 使用 Source-Available 许可，原始内容版权归作者所有，
            本站仅为中文教程二创，不分发原文件。
          </>
        )}
      </div>
    )}

    <Content />

    {tags.length > 0 && (
      <div class="article-tags" data-pagefind-ignore>
        {tags.map(t => (
          <a class="tag-chip" href={`/tags/${t.slug}/`}>#{t.label}</a>
        ))}
      </div>
    )}

    <hr />

    <p style="color: var(--color-text-muted); font-size: 0.9em;" data-pagefind-ignore>
      觉得有用？欢迎在 <a href={article.data.repo ?? article.data.source} target="_blank" rel="noopener">原 repo</a> 给作者一个 star。
      想看更多 Claude Skills 中文教程，<a href="/">回到首页</a>。
    </p>
  </article>
</Base>
